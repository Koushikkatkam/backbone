# ==============================================================================
# PROJECT BACKBONE — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# This application is designed to run self-contained out-of-the-box with NO external
# paid API keys required. Mock integrations are enabled by default.

# Database connection: SQLite for local prototype.
# In production, migrate to PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/backbone_db?schema=public
DATABASE_URL="file:./dev.db"

# Integration execution mode: "mock" (default for prototype), "test", or "live"
INTEGRATION_MODE="mock"

# Application environment
NODE_ENV="development"

# Secret token used for cookie demo session signing and encryption
SESSION_SECRET="change-this-to-a-secure-random-32-byte-hex-in-production"

# Public branding & regional display
NEXT_PUBLIC_APP_NAME="Project Backbone"
NEXT_PUBLIC_APP_REGION="Warangal & Mulugu Pilot, Telangana"
NEXT_PUBLIC_DEMO_TIMELINE="2026-10-26T18:00:00Z"

# ------------------------------------------------------------------------------
# Future external integration placeholders (Only enabled when INTEGRATION_MODE="live")
# During Shots 1-3, these remain mock adapters and require NO real keys.
# ------------------------------------------------------------------------------
# ESP32 / LoRaWAN Gateway API endpoint (e.g. ChirpStack / TTN)
# IOT_GATEWAY_URL="https://lora.telangana-agri.example.org/api/v1"
# IOT_GATEWAY_API_KEY=""

# AI Agronomy Advisory Provider (e.g. Gemini 1.5 Pro / Claude / OpenAI)
# AI_AGRONOMY_API_KEY=""
# AI_AGRONOMY_MODEL="gemini-1.5-pro"

# Payment and 24-hr Payout Gateway (e.g. RazorpayX / Cashfree / NPCI Sandbox)
# PAYMENT_GATEWAY_KEY=""
# PAYMENT_GATEWAY_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# SMS / WhatsApp Notification Gateway (e.g. Gupshup / Twilio)
# SMS_GATEWAY_API_KEY=""
# SMS_SENDER_ID="BKBNAG"

# Geospatial & Route Logistics API (e.g. Mapbox / Google Maps / OpenRouteService)
# MAP_GEO_API_KEY=""
